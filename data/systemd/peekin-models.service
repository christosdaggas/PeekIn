[Unit]
Description=PeekIn: decrypt the face models into memory
Documentation=man:peekin(1)
# The face models are encrypted with the TPM (and the host key); login
# screens read the decrypted copies in /run/peekin/models.
Wants=tpm2.target
After=tpm2.target local-fs.target systemd-tmpfiles-setup.service
Before=display-manager.service systemd-user-sessions.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/peekin unseal-models
# The decrypted copies live only while this unit is active: stopping it
# (also on package removal) removes them from memory. The directory is
# re-created, root:peekin 0750, by the command above at the next start.
RuntimeDirectory=peekin/models
RuntimeDirectoryMode=0750

[Install]
WantedBy=multi-user.target
