msgstr "Após desbloquear, uma notificação quando tiverem sido rejeitados rostos enquanto esteve ausente"

msgid "For this account only; press Apply to save changes."
msgstr "Apenas para esta conta; prima Aplicar para guardar as alterações."

msgid "Walk-away lock"
msgstr "Bloqueio por ausência"

msgid "Notifications"
msgstr "Notificações"

msgid "System status"
msgstr "Estado do sistema"

